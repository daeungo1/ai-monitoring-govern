{
  "name": "azure-openai-monitoring-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Privacy-first Azure OpenAI API observability, cost estimation and content-filter demo",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test tests/*.test.mjs",
    "demo:offline": "node dist/cli.js offline",
    "demo:live": "node dist/cli.js live",
    "demo:replay": "node dist/cli.js replay",
    "verify:azure": "node dist/verify.js",
    "prices:refresh": "node scripts/azure-prices.mjs",
    "monitoring:build": "node scripts/build-native-assets.mjs",
    "load:continuous": "node dist/load-worker.js"
  },
  "dependencies": {
    "@azure/functions": "4.16.5",
    "@azure/identity": "4.14.0",
    "@azure/monitor-opentelemetry-exporter": "1.0.0-beta.46",
    "@azure/storage-blob": "12.34.0",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-trace-node": "2.12.0",
    "openai": "7.30.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "~5.9.3"
  }
}
