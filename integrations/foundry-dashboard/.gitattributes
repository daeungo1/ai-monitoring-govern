# Normalize line endings so clones on any OS behave consistently.
* text=auto eol=lf

# Shell scripts must stay LF even on Windows checkouts.
*.sh text eol=lf

# Treat lockfiles/build outputs as generated in diffs.
package-lock.json linguist-generated=true
pnpm-lock.yaml linguist-generated=true

# Binary assets — never normalize.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
